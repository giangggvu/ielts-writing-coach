# Copy to .env and fill in. Never commit .env.

# Long random string, at least 32 characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_EXPIRE_MINUTES=1440

# Used when running without Docker. docker-compose.yml sets its own value.
DATABASE_URL=postgresql+psycopg://coach:coach@localhost:5432/coach

# --- AI provider ---------------------------------------------------------
# fake: offline demo, no key, scores are NOT real assessments
LLM_PROVIDER=fake

# Google Gemini (free tier via Google AI Studio: https://aistudio.google.com/apikey)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-lite-latest
# LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
# Any OpenAI-compatible API, e.g. Groq (free tier: https://console.groq.com/keys)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=

LLM_TIMEOUT_SECONDS=90

# --- Limits --------------------------------------------------------------
USER_DAILY_LIMIT=5
# Total gradings per day for the whole service, failed ones included (cost guard)
GLOBAL_DAILY_LIMIT=200
QUOTA_TIMEZONE=Asia/Ho_Chi_Minh
